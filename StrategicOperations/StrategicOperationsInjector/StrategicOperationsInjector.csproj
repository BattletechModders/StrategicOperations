<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk" InitialTargets="ValidateBattleTechGameDir">

  <Target Name="ValidateBattleTechGameDir" Condition="'$(BattleTechGameDir)' == '' Or !Exists('$(BattleTechGameDir)')">
    <Error Text="BattleTechGameDir variable not set properly" />
  </Target>

  <PropertyGroup Condition="'$(DeployedModPath)' == '' And Exists('$(BattleTechGameDir)\Mods\Core\StrategicOperations')">
    <!-- RogueTech -->
    <DeployedModPath>$(BattleTechGameDir)\Mods\Core\StrategicOperations</DeployedModPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DeployedModPath)' == '' And Exists('$(BattleTechGameDir)\Mods\StrategicOperations')">
    <!-- flat dir -->
    <DeployedModPath>$(BattleTechGameDir)\Mods\StrategicOperations</DeployedModPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DeployedModPath)' == ''">
    <!-- sources dir -->
    <DeployedModPath>$(MSBuildProjectDirectory)\..</DeployedModPath>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>11</LangVersion>

    <AssemblySearchPaths>
      $(ReferencePath);
      {HintPathFromItem};
      $(BattleTechGameDir)\BattleTech_Data\Managed\
    </AssemblySearchPaths>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <ProjectGuid>{994426BB-627E-472D-A92A-4C1357A3926A}</ProjectGuid>
    <RootNamespace>StrategicOperationsInjector</RootNamespace>
    <AssemblyName>StrategicOperationsInjector</AssemblyName>

    <AssemblyVersion>3.2.0</AssemblyVersion>
    <FileVersion>3.2.0</FileVersion>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" />
    <Publicize Include="Assembly-CSharp" />
    <PackageReference Include="HarmonyX" Version="2.16.1">
      <PrivateAssets>All</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <Reference Include="Mono.Cecil">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- the injector requires the ModTek.dll to be built and accessible -->
    <ProjectReference Include="..\StrategicOperations\StrategicOperations.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(DeployedModPath)\Mods\ModTek\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil.Mdb">
      <HintPath>$(DeployedModPath)\Mods\ModTek\Mono.Cecil.Mdb.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil.Pdb">
      <HintPath>$(DeployedModPath)\Mods\ModTek\Mono.Cecil.Pdb.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil.Rocks">
      <HintPath>$(DeployedModPath)\Mods\ModTek\Mono.Cecil.Rocks.dll</HintPath>
    </Reference>
    <Reference Include="System">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Core">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Data">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml.Linq">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="ModTek\Injectors\ModTekSimpleInjector.StrategicOperations.xml" />
  </ItemGroup>

  <Target Name="CopyFilesToGame" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployedModPath)\..\Mods\ModTek\Injectors" />
  </Target>

</Project>